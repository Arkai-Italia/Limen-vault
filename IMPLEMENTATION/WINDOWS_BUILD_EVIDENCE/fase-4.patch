+pub fn get_ai_settings_path() -> PathBuf {
+    if let Ok(override_path) = std::env::var("LIMEN_AI_SETTINGS_FILE") {
+        if !override_path.trim().is_empty() {
+            return PathBuf::from(override_path);
+        }
+    }
